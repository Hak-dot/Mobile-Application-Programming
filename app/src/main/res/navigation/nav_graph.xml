<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/exploreFragment">

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.nhom.movieapp.explore.ui.ExploreFragment"
        android:label="Khám phá" />

    <fragment
        android:id="@+id/watchlistFragment"
        android:name="com.nhom.movieapp.watchlist.ui.WatchlistFragment"
        android:label="Watchlist" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.nhom.movieapp.auth.ui.ProfileFragment"
        android:label="Hồ sơ">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nhom.movieapp.auth.ui.LoginFragment"
        android:label="Đăng nhập">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_explore"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.nhom.movieapp.auth.ui.RegisterFragment"
        android:label="Đăng ký">
        <action
            android:id="@+id/action_register_to_explore"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
